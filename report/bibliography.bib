@article{AT12b,
title = {Degree correlations in random geometric graphs},
abstract = {Spatially embedded networks are important in several disciplines. The prototypical spatial network we assume is the Random Geometric Graph of which many properties are known. Here we present new results for the two-point degree correlation function in terms of the clustering coefficient of the graphs for two-dimensional space in particular, with extensions to arbitrary finite dimension.},
