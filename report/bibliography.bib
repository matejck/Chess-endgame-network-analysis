@inproceedings{SZZKKLB12,
address = {Portoro{\v z}, Slovenia},
title = {Lastnosti velikih realnih omre{\v z}ij in primeri uporabe},
abstract = {V zadnjih letih so postala omre{\v z}ja izjemno popularna, saj predstavljajo mo{\v c}no orodje za predstavitev in analizo kompleksnih sistemov, sestavljenih iz velikega {\v s}tevila med seboj povezanih komponent. Tak{\v s}ne sisteme najdemo tako v realnem kot navideznem svetu, v naravi in tehnologiji, in so trenutno predmet {\v s}tevilnih analiz in {\v s}tudij. Teorija omre{\v z}ij je v preteklosti ponudila {\v z}e {\v s}tevilna pomembna spoznanja kot na primer fenomen majhnega sveta, odpornost tehnolo{\v s}kih omre{\v z}ij in obstoj komun v socialnih omre{\v z}jih. Poleg slednjega pa je omogo{\v c}ila razlago razli{\v c}nih dinami{\v c}nih procesov kot na primer gibanje ljudi v dru{\v z}bi, navigacija po svetovnem spletu ali pa nadzor v kompleksnih biolo{\v s}kih sistemih. Primere analize omre{\v z}ij tako najdemo v biologiji, dru{\v z}benih znanostih, ekonomiji, ra{\v c}unalni{\v s}tvu in informatiki, ter {\v s}e na {\v s}tevilnih drugih podro{\v c}jih. Kljub zgornjemu pa je uporaba teorije omre{\v z}ij {\v s}e vedno v veliki meri omejena zgolj na akademske kroge. V prispevku zato predstavimo osnovne lastnosti velikih omre{\v z}ij ter podamo nekatere zanimivej{\v s}e primere uporabe.},
language = {sl},
booktitle = {Zbornik {Konference} {Dnevi} {Slovenske} {Informatike}},
author = {{\v S}ubelj, Lovro and {\v Z}itnik, Slavko and Zrnec, Alja{\v z} and Kumer, Ale{\v s} and Klemenc, Bojan and Lavbi{\v c}, Dejan and Bajec, Marko},
year = {2012},
pages = {10}
}

@article{GMM12,
title = {The role of neural architecture and the speed of signal propagation in the process of synchronization of bursting neurons},
volume = {391},
abstract = {Synchronized neuronal activity has been observed at all levels of human and any other nervous systems and was suggested as particularly relevant in information processing and coding. In the present paper we investigate the synchronization of bursting neuronal activity. Motivated by the fact that in neural systems the interplay between the network structure and the dynamics taking place on it is closely interrelated, we develop a spatial network representation of neural architecture in which we can tune the network organization between a scale-free network with dominating long-range connections and a homogeneous network with mostly adjacent neurons connected. Our results reveal that the most synchronized response is obtained for the intermediate regime where long- as well as short-range connections constitute the neural architecture. Moreover, the optimal response is additionally enhanced when the speed of signal propagation is optimized.},
number = {8},
journal = {Physica A},
author = {Gosak, Marko and Markovi{\v c}, Rene and Marhl, Marko},
year = {2012},
pages = {2764--2770}
}

