@article{JM11,
title = {Traffic-light boundary in the deterministic {Nagel}-{Schreckenberg} model},
volume = {83},
abstract = {The characteristics of the deterministic Nagel{\textendash}Schreckenberg model with traffic-light boundary conditions are investigated and elucidated in a mostly theoretically way. First, precise analytical results of the outflow are obtained for cases in which the duration of the red phase is longer than one step. Then, some results are found and studied for cases in which the red phase equals one step. The main findings include the following. The maximum outflow is {\textquotedblleft}road-length related{\textquotedblright} if the inflow is saturated; otherwise, if the inbound cars are generated stochastically, multiple theoretical outflow volumes may exist. The findings indicate that although the traffic-light boundary can be implemented in a simple and deterministic manner, the deterministic Nagel{\textendash}Schreckenberg model with such a boundary has some unique and interesting behaviors.},
number = {6},
journal = {Phys. Rev. E},
author = {Jia, Ning and Ma, Shoufeng},
year = {2011},
pages = {061150}
}

@article{WLD11,
title = {Improving community detection in networks by targeted node removal},
volume = {83},
abstract = {How a network breaks up into subnetworks or communities is of wide interest. Here we show that vertices connected to many other vertices across a network can disturb the community structures of otherwise ordered networks, introducing noise. We investigate strategies to identify and remove noisy vertices ({\textquotedblleft}violators{\textquotedblright}) and develop a quantitative approach using statistical breakpoints to identify when the largest enhancement to a modularity measure is achieved. We show that removing nodes thus identified reduces noise in detected community structures for a range of different types of real networks in software systems and in biological systems.},
number = {1},
journal = {Phys. Rev. E},
author = {Wen, Haoran and Leicht, E. A. and D'Souza, Raissa M.},
year = {2011},
pages = {016114}
}

@article{BE93,
title = {Two algorithms for computing regular equivalence},
volume = {15},
abstract = {In this paper we present two algorithms for computing the extent of regular equivalence among pairs of nodes in a network. The first algorithm, REGE, is well known, but has not previously been described in the literature. The second algorithm, CATREGE, is new. Whereas REGE is applicable to quantitative data, CATREGE is used for categorical data. For binary data, either algorithm may be used, though the CATREGE algorithm is significantly faster and its output similarity coefficients have better metric properties. The CATREGE algorithm is also useful pedagogically, because it is easier to grasp.},
number = {4},
journal = {Soc. Networks},
author = {Borgatti, Stephen P. and Everett, Martin G.},
year = {1993},
pages = {361--376}
}

