title = {High degree vertices, eigenvalues and diameter of random {Apollonian} networks},
abstract = {In this work we analyze basic properties of Random Apollonian Networks {\textbackslash}cite\{zhang,zhou\}, a popular stochastic model which generates planar graphs with power law properties. Specifically, let \$k\$ be a constant and \${\textbackslash}Delta\_1 {\textbackslash}geq {\textbackslash}Delta\_2 {\textbackslash}geq .. {\textbackslash}geq {\textbackslash}Delta\_k\$ be the degrees of the \$k\$ highest degree vertices. We prove that at time \$t\$, for any function \$f\$ with \$f(t) {\textbackslash}rightarrow +{\textbackslash}infty\$ as \$t {\textbackslash}rightarrow +{\textbackslash}infty\$, \${\textbackslash}frac\{t{\textasciicircum}\{1/2\}\}\{f(t)\} {\textbackslash}leq {\textbackslash}Delta\_1 {\textbackslash}leq f(t)t{\textasciicircum}\{1/2\}\$ and for \$i=2,...,k=O(1)\$, \${\textbackslash}frac\{t{\textasciicircum}\{1/2\}\}\{f(t)\} {\textbackslash}leq {\textbackslash}Delta\_i {\textbackslash}leq {\textbackslash}Delta\_\{i-1\} - {\textbackslash}frac\{t{\textasciicircum}\{1/2\}\}\{f(t)\}\$ with high probability ({\textbackslash}whp). Then, we show that the \$k\$ largest eigenvalues of the adjacency matrix of this graph satisfy \${\textbackslash}lambda\_k = (1{\textbackslash}pm o(1)){\textbackslash}Delta\_k{\textasciicircum}\{1/2\}\$ {\textbackslash}whp. Furthermore, we prove a refined upper bound on the asymptotic growth of the diameter, i.e., that {\textbackslash}whp the diameter \$d(G\_t)\$ at time \$t\$ satisfies \$d(G\_t) {\textbackslash}leq {\textbackslash}rho {\textbackslash}log\{t\}\$ where \${\textbackslash}frac\{1\}\{{\textbackslash}rho\}={\textbackslash}eta\$ is the unique solution greater than 1 of the equation \${\textbackslash}eta - 1 - {\textbackslash}log\{{\textbackslash}eta\} = {\textbackslash}log\{3\}\$. Finally, we investigate other properties of the model.},
