title = {Analysis of topological properties in a seismic network},
volume = {391},
abstract = {In this study, we examine a seismic network by considering the cell resolution and the temporal causality. Seismic activity data from the Korean peninsula are mapped onto a growing network with links between consecutive events. After we especially show a seismic network with spatial heterogeneity and scales in an area, topological properties of this seismic activity network are measured and found. Our result for the robustness of these properties can be compared with other calculated findings.},
number = {6},
