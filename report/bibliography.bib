@article{MIKLSASA04,
title = {Superfamilies of evolved and designed networks},
volume = {303},
abstract = {Complex biological, technological, and sociological networks can be of very different sizes and connectivities, making it difficult to compare their structures. Here we present an approach to systematically study similarity in the local structure of networks, based on the significance profile (SP) of small subgraphs in the network compared to randomized networks. We find several superfamilies of previously unrelated networks with very similar SPs. One superfamily, including transcription networks of microorganisms, represents {\textquotedblleft}rate-limited{\textquotedblright} information-processing networks strongly constrained by the response time of their components. A distinct superfamily includes protein signaling, developmental genetic networks, and neuronal wiring. Additional superfamilies include power grids, protein-structure networks and geometric networks, World Wide Web links and social networks, and word-adjacency networks from different languages.},
number = {5663},
journal = {Science},
author = {Milo, Ron and Itzkovitz, Shalev and Kashtan, Nadav and Levitt, Reuven and Shen-Orr, Shai and Ayzenshtat, Inbal and Sheffer, Michal and Alon, Uri},
year = {2004},
pages = {1538--1542}
}

@article{RB03,
title = {Hierarchical organization in complex networks},
volume = {67},
abstract = {Many real networks in nature and society share two generic properties: they are scale-free and they display a high degree of clustering. We show that these two features are the consequence of a hierarchical organization, implying that small groups of nodes organize in a hierarchical manner into increasingly large groups, while maintaining a scale-free topology. In hierarchical networks, the degree of clustering characterizing the different groups follows a strict scaling law, which can be used to identify the presence of a hierarchical organization in real networks. We find that several real networks, such as the Worldwideweb, actor network, the Internet at the domain level, and the semantic web obey this scaling law, indicating that hierarchy is a fundamental characteristic of many complex systems.},
number = {2},
journal = {Phys. Rev. E},
author = {Ravasz, E. and Barab{\'a}si, Albert L{\'a}szl{\'o}},
year = {2003},
pages = {026112}
}

