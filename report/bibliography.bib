@article{FZZW12,
title = {Synchronous patterns in complex systems},
volume = {85},
abstract = {When a complex network is slightly desynchronized, a few of the network nodes will be escaping from the uniform synchronization background frequently with a random fashion, leading to the intermittent network synchronization. Here, based on the eigenvectors of the network coupling matrix, we propose a new method which is able to figure out the unstable nodes in the general case of desynchronized complex networks. Moreover, with this method, we are also able to regulate the seemingly random network dynamics into stable and visible synchronous patterns. The efficiency of this method is verified by a variety of network models, including varying the network structures, the node local dynamics, and the desynchronization types. Our studies show that, even for the complex network systems, synchronous patterns can still be identified and characterized.},
number = {6},
journal = {Phys. Rev. E},
author = {Fu, Chenbo and Zhang, Hong and Zhan, Meng and Wang, Xingang},
year = {2012},
pages = {066208}
}

