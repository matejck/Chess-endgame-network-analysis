@article{DBM12,
title = {Dense and sparse graph partition},
volume = {160},
abstract = {In a graph G = ( V , E ) , the density is the ratio between the number of edges {\textbar} E {\textbar} and the number of vertices {\textbar} V {\textbar} . This criterion may be used to find communities in a graph: groups of highly connected vertices. We propose an optimization problem based on this criterion; the idea is to find the vertex partition that maximizes the sum of the densities of each class. We prove that this problem is NP-hard by giving a reduction from graph- k -colorability. Additionally, we give a polynomial time algorithm for the special case of trees.},
number = {16{\textendash}17},
journal = {Discrete Appl. Math.},
author = {Darlay, Julien and Brauner, Nadia and Moncel, Julien},
year = {2012},
pages = {2389--2396}
}

@article{RHYLZ14,
title = {The adaptive coupling scheme and the heterogeneity in intrinsic frequency and degree distributions of the complex networks},
volume = {378},
abstract = {In the paper, we applied an adaptive principle to three kinds of complex networks as well as a random network within the context of the Kuramoto model. We found that the adaptive scheme could suppress the negative effect of the heterogeneity in the networks and the phase synchronization is enhanced obviously. The paper mainly investigates the adaptive coupling scheme in the small-world network, the scale-free network, and the modular network. Comparing with other weighted or unweighted static coupling schemes, the adaptive coupling scheme has a better performance in synchronization and communication efficiency, and provides a more realistic picture of synchronization in complex networks.},
number = {3},
journal = {Phys. Lett. A},
author = {Ren, Quansheng and He, Mingli and Yu, Xiaoqian and Long, Qiufeng and Zhao, Jianye},
year = {2014},
