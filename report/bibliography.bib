title = {Weighted scale-free networks induced by group preferential mechanism},
volume = {390},
abstract = {Based on the BBV model [A. Barrat, M. Barthelemy, A. Vespignani, Phys. Rev. Lett. 92 (22) (2004)], we propose a weighted group preferential model, which is generated by the group preferential mechanism. We derive analytically the various statistical properties, such as the distribution of degree, strength and weight, the degree-strength relationship. Finally, we provide a contrast with the BBV model on the synchronization robustness and fragility through numerical simulation.},
