@article{SE17,
title = {Are {Erdos}-{Renyi} random graphs topologically random?},
abstract = {No. We prove that Erd{\textbackslash}"os- R{\textbackslash}'enyi Random Graphs are not topologically random. This begins to provide mathematical explanation as to why random graphs fail to explain topological characteristics of real world networks. This has far reaching consequences for the randomisation processes implemented in Network Science.},
journal = {e-print arXiv:170300210v1},
author = {Smith, Keith and Escudero, Javier},
year = {2017}
}

