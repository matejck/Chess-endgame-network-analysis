@article{MF01,
title = {Identifying {Web} browsing trends and patterns},
volume = {34},
abstract = {Since it entered the popular culture in 1994, the World Wide Web{\textless}br/{\textgreater}has grown from approximately two million servers to more than 110{\textless}br/{\textgreater}million in 2001, according to the Internet Software Consortium. Jupiter{\textless}br/{\textgreater}Media Metrix, an Internet research company, estimates that during this{\textless}br/{\textgreater}same period, the number of US home Web users has likewise increased from{\textless}br/{\textgreater}3 million to more than 89 million. Has this phenomenal growth resulted{\textless}br/{\textgreater}in fundamental changes in the way users browse the Web? To address this{\textless}br/{\textgreater}question, we analyzed a sample of more than 20,000 Internet users who{\textless}br/{\textgreater}accessed the Web from July 1997 through December 1999. This nationally{\textless}br/{\textgreater}representative data set collected by Jupiter Media Metrix is unique{\textless}br/{\textgreater}because it was gathered from users' computers, not servers, thus it is{\textless}br/{\textgreater}immune to caching problems present in other Web usage studies},
