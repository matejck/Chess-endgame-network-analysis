author = {Taskar, Ben and Wong, Ming-Fai and Abbeel, Pieter and Koller, Daphne},
year = {2003}
}

@inproceedings{YLSSZZ11,
title = {Like like alike: {Joint} friendship and interest propagation in social networks},
booktitle = {Proceedings of the {International} {World} {Wide} {Web} {Conference}},
author = {Yang, S. H. and Long, Bo and Smola, Alex and Sadagopan, N. and Zheng, Z. and Zha, H.},
