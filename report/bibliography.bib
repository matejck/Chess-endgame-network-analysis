booktitle = {Proceedings of the {IEEE} {International} {Conference} on {Social} {Computing}},
author = {Fire, Michael and Tenenboim, Lena and Lesser, Ofrit and Puzis, Rami and Rokach, Lior and Elovici, Yuval},
