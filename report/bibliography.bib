@article{BXD98,
title = {Using {Kohonen}'s self-organizing feature map to uncover automobile bodily injury claims fraud},
volume = {65},
abstract = {Claims fraud is an increasingly vexing problem confronting the insurance industry. In this empirical study, we apply Kohonen's Self-Organizing Feature Map to classify automobile bodily injury (BT) claims by the degree of fraud suspicion. Feed forward neural networks and a back propagation algorithm are used to investigate the validity of the Feature Map approach. Comparative experiments illustrate the potential usefulness of the proposed methodology. We show that this technique performs better than both an insurance adjuster's fraud assessment and an insurance investigator's fraud assessment with respect to consistency and reliability.},
number = {2},
journal = {J. Risk Insur.},
author = {Brockett, P. L and Xia, X. H and Derrig, R. A},
year = {1998},
pages = {245--274}
}

