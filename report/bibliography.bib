@article{CH11a,
title = {Optimal modularity for nucleation in a network-organized {Ising} model},
volume = {83},
abstract = {We study the nucleation dynamics of the Ising model in a topology that consists of two coupled random networks, thereby mimicking the modular structure observed in real-world networks. By introducing a variant of a recently developed forward flux sampling method, we efficiently calculate the rate and elucidate the pathway for the nucleation process. It is found that as the network modularity worsens the nucleation undergoes a transition from a two-step to one-step process. Interestingly, the nucleation rate shows a nonmonotonic dependence on the modularity, in which a maximal nucleation rate occurs at a moderate level of modularity. A simple mean-field analysis is proposed to qualitatively illustrate the simulation results.},
number = {4},
journal = {Phys. Rev. E},
author = {Chen, Hanshuang and Hou, Zhonghuai},
year = {2011},
pages = {046124}
}

@article{CH11b,
title = {Comment on {\textquotedblleft}{Evolutionary} method for finding communities in bipartite networks{\textquotedblright}},
volume = {84},
abstract = {In a recent paper, Zhan, Zhang, Guan, and Zhou [ Phys. Rev. E 83 066120 (2011)] presented a modified adaptive genetic algorithm (MAGA) tailored to the discovery of maximum modularity partitions of the node set into communities in unipartite, bipartite, and directed networks. The authors claim that {\textquotedblleft}detection of communities in unipartite networks or in directed networks can be transformed into the same task in bipartite networks.{\textquotedblright} Actually, some tests show that it is not the case for the proposed transformations, and why. Experimental results of MAGA for modularity maximization of untransformed unipartite or bipartite networks are also discussed.},
number = {5},
journal = {Phys. Rev. E},
author = {Costa, Alberto and Hansen, Pierre},
year = {2011},
