@article{PPV12,
title = {Parallel clustering with {CFinder}},
volume = {22},
abstract = {The amount of available data about complex systems is increasing every year, measurements of larger and larger systems are collected and recorded. A natural representation of such data is given by networks, whose size is following the size of the original system. The current trend of multiple cores in computing infrastructures call for a parallel reimplementation of earlier methods. Here we present the grid version of CFinder, which can locate overlapping communities in directed, weighted or undirected networks based on the clique percolation method (CPM). We show that the computation of the communities can be distributed among several CPU-s or computers. Although switching to the parallel version not necessarily leads to gain in computing time, it definitely makes the community structure of extremely large networks accessible.},
number = {1},
journal = {Parallel Processing Letters},
author = {Pollner, Peter and Palla, Gergely and Vicsek, Tamas},
year = {2012},
pages = {1240001}
}

@article{DEB02,
title = {Emergence of a small world from local interactions: {Modeling} acquaintance networks},
volume = {88},
abstract = {How do we make acquaintances? A simple observation from everyday experience is that often one of our acquaintances introduces us to one of his or her acquaintances. Such a simple triangle interaction may be viewed as the basis of the evolution of many social networks. Here, it is demonstrated that this assumption is sufficient to reproduce major nontrivial features of social networks: short path length, high clustering, and scale-free or exponential link distributions.},
number = {12},
journal = {Phys. Rev. Lett.},
author = {Davidsen, J{\"o}rn and Ebel, Holger and Bornholdt, Stefan},
year = {2002},
pages = {128701}
}

