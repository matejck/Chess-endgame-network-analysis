@article{NLKL14,
title = {Correlation and network topologies in global and local stock indices},
volume = {378},
abstract = {We examined how the correlation and network structure of the global indices and local Korean indices have changed during years 2000{\textendash}2012. The average correlations of the global indices increased with time, while the local indices showed a decreasing trend except for drastic changes during the crises. A significant change in the network topologies was observed due to the financial crises in both markets. The Jaccard similarities identified the change in the market state due to a crisis in both markets. The dynamic change of the Jaccard index can be used as an indicator of systemic risk or precursors of the crisis.},
number = {34},
journal = {Phys. Lett. A},
author = {Nobi, Ashadun and Lee, Sungmin and Kim, Doo Hwan and Lee, Jae Woo},
year = {2014},
pages = {2482--2489}
