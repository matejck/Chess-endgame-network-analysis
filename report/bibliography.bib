@inproceedings{ZSJFDKMB13,
address = {Portoro{\v z}, Slovenia},
title = {Iterative end-to-end information extraction based on linear models},
abstract = {Information Extraction is a process of extracting structured data from unstructured sources. It roughly consists of tasks like entity extraction, relation extraction and coreference resolution. Most of the current re- search focuses only on one of the tasks or their combination in a pipeline. In this paper we introduce an end- to-end iterative information extraction system. We propose a novel dataset transformation which enables the use linear-chain conditional random fields for all the three tasks. The usage of efficient linear model en- ables faster training and inference with parallelization possibilities.},
language = {en},
booktitle = {Proceedings of the {International} {Electrotechnical} and {Computer} {Science} {Conference}},
author = {{\v Z}itnik, Slavko and {\v S}ubelj, Lovro and Jankovi{\v c}, Marko and Furlan, Bojan and Dra{\v s}kovi{\v c}, Dra{\v z}en and Koji{\v c}, Nemanja and Mi{\v s}i{\v c}, Marko and Bajec, Marko},
year = {2013},
pages = {47--50}
}

@book{CB90,
address = {Belmont},
title = {Statistical {Inference}},
