@inproceedings{SBB13,
address = {Copenhagen, Denmark},
title = {Group extraction for real-world networks: {The} case of communities, modules, and hubs and spokes},
shorttitle = {Group extraction for real-world networks},
abstract = {Large real-world networks are often composed of characteristic groups of nodes with common linking pattern. Densely connected groups known as communities are perhaps the most well studied example with diverse applications in various fields. However, most real-world networks also contain other characteristic groups of nodes, while some parts of networks reveal no significant groups at all. To overcome the latter, Zhao{\textasciitilde}{\textbackslash}textit\{et{\textasciitilde}al.\} have recently proposed a community extraction criteria that explicitly guards against extracting groups that are not statistically significant. We extend their framework to arbitrary groups of nodes and propose a local group quality criteria \$W\$. Let \$S\$ be a group of nodes and let \$T\$ represent its linking pattern. Criteria \$W\$ favors links between \$S\$ and \$T\$, and penalizes links between \$S\$ and \$T{\textasciicircum}C\$, while disregarding links with both endpoints in \$S{\textasciicircum}C\$. For this talk we consider groups with \$S=T\$ that correspond to communities and groups with \$S{\textbackslash}cap T={\textbackslash}emptyset\$ denoted modules, with hub and spokes as a special case (for \${\textbar}T{\textbar}=1\$). We apply the extraction framework to the famous American football social network and a software network compiled from JUNG network analysis library (among others). Expectedly, communities explain almost \$70{\textbackslash}\%\$ of the structure in the case of the social network, while other groups account for less than \$5{\textbackslash}\%\$ (according to the number of links \${\textbar}L{\textbar}\$). On the other hand, communities contain only \${\textbackslash}approx 12{\textbackslash}\%\$ of the links in the software network, whereas modules, and hubs and spokes, account for \${\textbackslash}approx 65{\textbackslash}\%\$ of the structure. All extracted groups well coincide with the ground truth and the literature.},
language = {en},
booktitle = {Proceedings of the {International} {Conference} on {Network} {Science}},
author = {{\v S}ubelj, Lovro and Blagus, Neli and Bajec, Marko},
year = {2013},
pages = {152--153}
}

