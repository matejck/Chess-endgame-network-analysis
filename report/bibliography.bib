@article{LZZ12,
title = {Degree heterogeneity in spatial networks with total cost constraint},
volume = {98},
abstract = {Recently, In [Phys. Rev. Lett. 104, 018701 (2010)] the authors studied a spatial network which is constructed from a regular lattice by adding long-range edges (shortcuts) with probability \$P\_\{ij\}{\textbackslash}sim r\_\{ij\}{\textasciicircum}\{-{\textbackslash}alpha\}\$, where \$r\_\{ij\}\$ is the Manhattan length of the long-range edges. The total length of the additional edges is subject to a cost constraint (\${\textbackslash}sum r=C\$). These networks have fixed optimal exponent \${\textbackslash}alpha\$ for transportation (measured by the average shortest-path length). However, we observe that the degree in such spatial networks is homogenously distributed, which is far different from real networks such as airline systems. In this paper, we propose a method to introduce degree heterogeneity in spatial networks with total cost constraint. Results show that with degree heterogeneity the optimal exponent shifts to a smaller value and the average shortest-path length can further decrease. Moreover, we consider the synchronization on the spatial networks and related results are discussed. Our new model may better reproduce the features of many real transportation systems.},
number = {2},
journal = {Europhys. Lett.},
author = {Liu, Weiping and Zeng, An and Zhou, Yanbo},
year = {2012},
pages = {28003}
}

