@inproceedings{Pau11,
title = {A new notion of centrality for dense graphs},
abstract = {In the analysis of networks, centrality measures are used to illuminate structure by identifying nodes and edges which have privileged roles in the connectivity of the graph. However, for dense networks, such as those arising from the similarity structure of time series, these measures are often uninformative or inapplicable. We introduce a new measure of centrality, spectral centrality, which captures the extent to which a deformations of edge weights change the structure of the network. More precisely, spectral centrality measures the derivative of the Fiedler value of the network under a deformation of the weights of the specified edges.,
We present initial applications to toy networks to show the similarities and dif- ferences with other centralities in the literature as well as to two networks based on real data, the correlation network of the S\&P 500 close price series and a network associated to the voting patterns of the 111th U.S. House of Representatives.},
booktitle = {Proceedings of the {International} {Conference} on {Complex} {Systems}},
author = {Pauls, Scott},
year = {2011}
}

