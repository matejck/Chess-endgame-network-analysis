@article{BP12,
title = {A quality driven hierarchical data divisive soft clustering for information retrieval},
volume = {26},
abstract = {In this paper an adaptive hierarchical fuzzy clustering algorithm is presented, named Hierarchical Data Divisive Soft Clustering (H2D-SC). The main novelty of the proposed algorithm is that it is a quality driven algorithm, since it dynamically evaluates a multi-dimensional quality measure of the clusters to drive the generation of the soft hierarchy. Specifically, it generates a hierarchy in which each node is split into a variable number of sub-nodes, determined by an innovative quality assessment of soft clusters, based on the evaluation of multiple dimensions such as the cluster{\textquoteright}s cohesion, its cardinality, its mass, and its fuzziness, as well as the partition{\textquoteright}s entropy. Clusters at the same hierarchical level share a minimum quality value: clusters in the lower levels of the hierarchy have a higher quality; this way more specific clusters (lower level clusters) have a higher quality than more general clusters (upper level clusters). Further, since the algorithm generates a soft partition, a document can belong to several sub-clusters with distinct membership degrees. The proposed algorithm is divisive, and it is based on a combination of a modified bisecting K-Means algorithm with a flat soft clustering algorithm used to partition each node. The paper describes the algorithm and its evaluation on two standard collections.},
journal = {Knowl.-Based Syst.},
author = {Bordogna, Gloria and Pasi, Gabriella},
year = {2012},
pages = {9--19}
}

@article{Roc11,
title = {{EM} algorithm and variants: {An} informal tutorial},
abstract = {The expectation-maximization (EM) algorithm introduced by Dempster et al in 1977 is a very general method to solve maximum likelihood estimation problems. In this informal report, we review the theory behind EM as well as a number of EM variants, suggesting that beyond the current state of the art is an even much wider territory still to be discovered.},
journal = {e-print arXiv:11051476v1},
author = {Roche, Alexis},
year = {2011}
}

