@article{RZ11,
title = {Geometry of complex networks and structural centrality},
abstract = {We explore the geometry of complex networks in terms of an n-dimensional Euclidean embedding represented by the Moore-Penrose pseudo-inverse of the graph Laplacian \$({\textbackslash}bb L{\textasciicircum}+)\$. The squared distance of a node \$i\$ to the origin in this n-dimensional space \$(l{\textasciicircum}+\_\{ii\})\$, yields a structural centrality index \$({\textbackslash}mathcal\{C\}{\textasciicircum}\{*\}(i) = 1/l{\textasciicircum}+\_\{ii\})\$ for node \$i\$. In turn, the sum of reciprocals of individual node structural centralities, \${\textbackslash}sum\_\{i\}1/{\textbackslash}mathcal\{C\}{\textasciicircum}*(i) = {\textbackslash}sum\_\{i\} l{\textasciicircum}+\_\{ii\}\$, i.e. the trace of \${\textbackslash}bb L{\textasciicircum}+\$, yields the well-known Kirchoff index \$({\textbackslash}mathcal\{K\})\$, an overall structural descriptor for the network. In addition to this geometric interpretation, we provide alternative interpretations of the proposed indices: first, in terms of forced detour overheads and frequency of recurrences in random walks that has an interesting analogy to voltage distributions in the equivalent electrical network; and then as the average connectedness of \$i\$ in all the bi-partitions of the graph. This helps establish the structural centrality \$({\textbackslash}mathcal\{C\}{\textasciicircum}\{*\}(i))\$ as a measure of both the overall position as well as the overall connectedness of node \$i\$ in the network which in turn reflects the robustness of node \$i\$ to random failures. Through empirical evaluations using synthetic and real world networks, we demonstrate how the structural centrality is better able to distinguish nodes in terms of their structural roles in the network and, along with Kirchoff index, is appropriately sensitive to perturbations/rewirings in the network.},
journal = {e-print arXiv:11070989v1},
author = {Ranjan, Gyan and Zhang, Zhi-Li},
year = {2011}
}

