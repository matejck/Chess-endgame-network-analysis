@article{Che12,
title = {The walk distances in graphs},
abstract = {We study the walk distances for graph vertices, which are obtained by means of appropriate transformations from the \${\textbackslash}sum\_\{k=0\}{\textasciicircum}{\textbackslash}infty(tA){\textasciicircum}k\$ proximity measure, where \$A\$ is the weighted adjacency matrix of a graph and \$t\$ is a sufficiently small positive parameter. The walk distances are graph-geodetic, moreover, they converge to the shortest path distance and to the so-called long walk distance as the parameter \$t\$ approaches its limiting values. We also show that the logarithmic forest distances proposed by the present author are a subclass of the walk distances.},
journal = {e-print arXiv:11032059v7},
author = {Chebotarev, Pavel},
year = {2012}
}

@article{ELW12,
title = {Who are the objects of positive and negative gossip at work? {A} social network perspective on workplace gossip},
volume = {34},
abstract = {Gossip is informal talking about colleagues. Taking a social network perspective, we argue that group boundaries and social status in the informal workplace network determine who the objects of positive and negative gossip are. Gossip networks were collected among 36 employees in a public child care organization, and analyzed using exponential random graph modeling (ERGM). As hypothesized, both positive and negative gossip focuses on colleagues from the own gossiper's work group. Negative gossip is relatively targeted, with the objects being specific individuals, particularly those low in informal status. Positive gossip, in contrast, is spread more evenly throughout the network.},
number = {2},
journal = {Soc. Networks},
author = {Ellwardt, Lea and Labianca, Giuseppe (Joe) and Wittek, Rafael},
year = {2012},
pages = {193--205}
}

@inproceedings{ZWSY12,
title = {Inferring the underlying structure of information cascades},
abstract = {In social networks, information and influence diffuse among users as cascades. While the importance of studying cascades has been recognized in various applications, it is difficult to observe the complete structure of cascades in practice. Moreover, much less is known on how to infer cascades based on partial observations. In this paper we study the cascade inference problem following the independent cascade model, and provide a full treatment from complexity to algorithms: (a) We propose the idea of consistent trees as the inferred structures for cascades; these trees connect source nodes and observed nodes with paths satisfying the constraints from the observed temporal information. (b) We introduce metrics to measure the likelihood of consistent trees as inferred cascades, as well as several optimization problems for finding them. (c) We show that the decision problems for consistent trees are in general NP-complete, and that the optimization problems are hard to approximate. (d) We provide approximation algorithms with performance guarantees on the quality of the inferred cascades, as well as heuristics. We experimentally verify the efficiency and effectiveness of our inference algorithms, using real and synthetic data.},
booktitle = {Proceedings of the {IEEE} {International} {Conference} on {Data} {Mining}},
author = {Zong, Bo and Wu, Yinghui and Singh, Ambuj K. and Yan, Xifeng},
year = {2012}
}

