@article{SMNAOJCJMR11,
title = {Social network size affects neural circuits in macaques},
volume = {334},
abstract = {It has been suggested that variation in brain structure correlates with the sizes of individuals{\textquoteright} social networks. Whether variation in social network size causes variation in brain structure, however, is unknown. To address this question, we neuroimaged 23 monkeys that had been living in social groups set to different sizes. Subject comparison revealed that living in larger groups caused increases in gray matter in mid-superior temporal sulcus and rostral prefrontal cortex and increased coupling of activity in frontal and temporal cortex. Social network size, therefore, contributes to changes both in brain structure and function. The changes have potential implications for an animal{\textquoteright}s success in a social context; gray matter differences in similar areas were also correlated with each animal{\textquoteright}s dominance within its social network.},
number = {6056},
journal = {Science},
author = {Sallet, J. and Mars, R. B. and Noonan, M. P. and Andersson, J. L. and O{\textquoteright}Reilly, J. X. and Jbabdi, S. and Croxson, P. L. and Jenkinson, M. and Miller, K. L. and Rushworth, M. F. S.},
year = {2011},
pages = {697--700}
}

@article{SGP11a,
title = {Estimating {PageRank} on graph streams},
volume = {58},
abstract = {This article focuses on computations on large graphs (e.g., the web-graph) where the edges of the graph are presented as a stream. The objective in the streaming model is to use small amount of memory (preferably sub-linear in the number of nodes n) and a smaller number of passes. In the streaming model, we show how to perform several graph computations including estimating the probability distribution after a random walk of length l, the mixing time M, and other related quantities such as the conductance of the graph. By applying our algorithm for computing probability distribution on the web-graph, we can estimate the PageRank p of any node up to an additive error of \&sqrt;$\varepsilon$ p+$\varepsilon$ in {\~O}(\&sqrt;M/$\alpha$) passes and {\~O}(min(n$\alpha$+1/$\varepsilon$\&sqrt;M/$\alpha$+(1/$\varepsilon$)M$\alpha$, $\alpha$ n\&sqrt;M$\alpha$ + (1/$\varepsilon$)\&sqrt;M/$\alpha$)) space, for any $\alpha$ ? (0,1]. Specifically, for $\varepsilon$ = M/n, $\alpha$ = M-1/2, we can compute the approximate PageRank values in {\~O}(nM-1/4) space and {\~O}(M3/4) passes. In comparison, a standard implementation of the PageRank algorithm will take O(n) space and O(M) passes. We also give an approach to approximate the PageRank values in just {\~O}(1) passes although this requires {\~O}(nM) space.},
number = {3},
journal = {J. ACM},
author = {Sarma, Atish Das and Gollapudi, Sreenivas and Panigrahy, Rina},
year = {2011}
}

@article{SGP11b,
title = {Percolation transitions are not always sharpened by making networks interdependent},
volume = {107},
abstract = {We study a model for coupled networks introduced recently by Buldyrev et al., [ Nature (London) 464 1025 (2010)], where each node has to be connected to others via two types of links to be viable. Removing a critical fraction of nodes leads to a percolation transition that has been claimed to be more abrupt than that for uncoupled networks. Indeed, it was found to be discontinuous in all cases studied. Using an efficient new algorithm we verify that the transition is discontinuous for coupled Erd{\"o}s-R{\'e}nyi networks, but find it to be continuous for fully interdependent diluted lattices. In 2 and 3 dimensions, the order parameter exponent $\beta$ is larger than in ordinary percolation, showing that the transition is less sharp, i.e., further from discontinuity, than for isolated networks. Possible consequences for spatially embedded networks are discussed.},
number = {19},
journal = {Phys. Rev. Lett.},
author = {Son, Seung-Woo and Grassberger, Peter and Paczuski, Maya},
year = {2011},
pages = {195702}
}

@article{GW12b,
title = {The citation networks model with random aging},
volume = {17},
abstract = {In citation networks, the age of the articles published plays an important role in deciding the preferential attachment probability of the publishing article. In this article, we consider the aging to be cited of the article decays as (t-ti) -$\eta$, where t - ti denotes the time when node i exists in the networks, $\eta$ is a random variable and denotes the aging decay exponent of the article published. We deduce that the degree distribution of a citation network also shows power-law dependence P(k) \~{} k -$\gamma$ with exponent $\gamma$ ? 3. At the same time, we study the clustering property of this networks, calculate the clustering coefficient of node i in citation network. We find that the clustering coefficient of node i is larger if its neighbors add into the net earlier. {\textcopyright} 2011 Wiley Periodicals, Inc. Complexity, 2011.},
number = {4},
journal = {Complex.},
author = {Geng, Xianmin and Wang, Ying},
year = {2012},
pages = {16--22}
}

