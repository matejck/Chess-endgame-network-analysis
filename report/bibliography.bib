}

@inproceedings{PDSZLJPN13,
address = {Portoro{\v z}, Slovenia},
title = {Intelligent techniques for searching {Internet} forums},
abstract = {Web crawlers are one of the most Internet searching techniques today. This paper provides an overview of the most famous forum web crawlers, their performances and disadvantages. Searching problems have been examined predominantly and improvement measures leading to better searching results have been proposed and exemplified by web forums.},
language = {en},
booktitle = {Proceedings of the {International} {Electrotechnical} and {Computer} {Science} {Conference}},
author = {Pavkovi{\v c}, Milo{\v s} and Dra{\v s}kovi{\v c}, Dra{\v z}en and {\v S}ubelj, Lovro and {\v Z}itnik, Slavko and Lavbi{\v c}, Dejan and Jankovi{\v c}, Marko and Proti{\v c}, Jelica and Nikoli{\v c}, Bo{\v s}ko},
year = {2013},
