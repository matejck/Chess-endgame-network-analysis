@article{Koc07,
title = {Harmonic evolutions on graphs},
volume = {2},
abstract = {We define the harmonic evolution of states of a graph by iterative application of the harmonic operator (Laplacian over \$Z\_2\$). This provides graphs with a new geometric context and leads to a new tool to analyze them. The digraphs of evolutions are analyzed and classified. This construction can also be viewed as a certain topological generalization of cellular automata.},
number = {1},
journal = {Int. J. Math. Comp.},
author = {Kocik, Jerzy},
year = {2007},
pages = {65--82}
}

