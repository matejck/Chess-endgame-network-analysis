@article{SKP12,
title = {Community structure and scale-free collections of {Erdos}-{Renyi} graphs},
volume = {85},
abstract = {Community structure plays a significant role in the analysis of social networks and similar graphs, yet this structure is little understood and not well captured by most models. We formally define a community to be a subgraph that is internally highly connected and has no deeper substructure. We use tools of combinatorics to show that any such community must contain a dense Erd{\textbackslash}"os-R{\textbackslash}'enyi (ER) subgraph. Based on mathematical arguments, we hypothesize that any graph with a heavy-tailed degree distribution and community structure must contain a scale free collection of dense ER subgraphs. These theoretical observations corroborate well with empirical evidence. From this, we propose the Block Two-Level Erd{\textbackslash}"os-R{\textbackslash}'enyi (BTER) model, and demonstrate that it accurately captures the observable properties of many real-world social networks.},
number = {5},
journal = {Phys. Rev. E},
author = {Seshadhri, C. and Kolda, Tamara G. and Pinar, Ali},
year = {2012},
pages = {056109}
}

@article{PTC12,
title = {Heterogeneous length of stay of hosts' movements and spatial epidemic spread},
volume = {2},
abstract = {Infectious diseases outbreaks are often characterized by a spatial component induced by hosts' distribution, mobility, and interactions. Spatial models that incorporate hosts' movements are being used to describe these processes, to investigate the conditions for propagation, and to predict the spatial spread. Several assumptions are being considered to model hosts' movements, ranging from permanent movements to daily commuting, where the time spent at destination is either infinite or assumes a homogeneous fixed value, respectively. Prompted by empirical evidence, here we introduce a general metapopulation approach to model the disease dynamics in a spatially structured population where the mobility process is characterized by a heterogeneous length of stay. We show that large fluctuations of the length of stay, as observed in reality, can have a significant impact on the threshold conditions for the global epidemic invasion, thus altering model predictions based on simple assumptions, and displaying important public health implications.},
journal = {Sci. Rep.},
author = {Poletto, Chiara and Tizzoni, Michele and Colizza, Vittoria},
year = {2012},
pages = {476}
}

