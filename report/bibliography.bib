@article{BH11,
title = {The combined effect of connectivity and dependency links on percolation of networks},
abstract = {Percolation theory is extensively studied in statistical physics and mathematics with applications in diverse fields. However, the research is focused on systems with only one type of links, connectivity links. We review a recently developed mathematical framework for analyzing percolation properties of realistic scenarios of networks having links of two types, connectivity and dependency links. This formalism was applied to study Erd\${\textbackslash}ddot\{o\}\$s-R\${\textbackslash}acute\{e\}\$nyi (ER) networks that include also dependency links. For an ER network with average degree \$k\$ that is composed of dependency clusters of size \$s\$, the fraction of nodes that belong to the giant component, \$P\_{\textbackslash}infty\$, is given by \$ P\_{\textbackslash}infty=p{\textasciicircum}\{s-1\}[1-{\textbackslash}exp\{(-kpP\_{\textbackslash}infty)\}]{\textasciicircum}s \$ where \$1-p\$ is the initial fraction of randomly removed nodes. Here, we apply the formalism to the study of random-regular (RR) networks and find a formula for the size of the giant component in the percolation process: \$P\_{\textbackslash}infty=p{\textasciicircum}\{s-1\}(1-r{\textasciicircum}k){\textasciicircum}s\$ where \$r\$ is the solution of \$r=p{\textasciicircum}s(r{\textasciicircum}\{k-1\}-1)(1-r{\textasciicircum}k)+1\$. These general results coincide, for \$s=1\$, with the known equations for percolation in ER and RR networks respectively without dependency links. In contrast to \$s=1\$, where the percolation transition is second order, for \$s{\textgreater}1\$ it is of first order. Comparing the percolation behavior of ER and RR networks we find a remarkable difference regarding their resilience. We show, analytically and numerically, that in ER networks with low connectivity degree or large dependency clusters, removal of even a finite number (zero fraction) of the network nodes will trigger a cascade of failures that fragments the whole network. This result is in contrast to RR networks where such cascades and full fragmentation can be triggered only by removal of a finite fraction of nodes in the network.},
journal = {J. Stat. Phys.},
author = {Bashan, Amir and Havlin, Shlomo},
year = {2011}
}

@article{LLBLN08,
title = {From time series to complex networks: {The} visibility graph},
volume = {105},
abstract = {In this work we present a simple and fast computational method, the visibility algorithm, that converts a time series into a graph. The constructed graph inherits several properties of the series in its structure. Thereby, periodic series convert into regular graphs, and random series do so into random graphs. Moreover, fractal series convert into scale-free networks, enhancing the fact that power law degree distributions are related to fractality, something highly discussed recently. Some remarkable examples and analytical tools are outlined to test the method's reliability. Many different measures, recently developed in the complex network theory, could by means of this new approach characterize time series from a new point of view.},
number = {13},
journal = {P. Natl. Acad. Sci. USA},
author = {Lacasa, Lucas and Luque, Bartolo and Ballesteros, Fernando and Luque, Jordi and Nu{\~n}o, Juan Carlos},
year = {2008},
pages = {4972--4975}
}

@inproceedings{SBFKKLZZB10,
address = {Brdo pri Kranju, Slovenia},
title = {Analiza kompleksnih omre{\v z}ij: {Osnovni} pojmi in primeri uporabe v praksi},
shorttitle = {Analiza kompleksnih omre{\v z}ij},
abstract = {Predvsem z razmahom svetovnega spleta, dru{\v z}abnih omre{\v z}ij in drugih oblik sporo{\v c}anja so se v zadnjih letih za{\v c}ele pojavljati bogate podatkovne zbirke, ki poleg osnovnih lastnosti o posameznikih hranijo tudi razli{\v c}ne vrste relacij med njimi. Relacije med entitetami navadno skrivajo veliko koli{\v c}ino informacij, in tako razkrivajo kompleksne lastnosti, ki bi sicer pogosto ostale neodkrite. S preu{\v c}evanjem relacij med entitetami se ukvarja analiza omre{\v z}ij, ki trenutno velja za eno najbolj aktualnih podro{\v c}ij v analizi podatkov. V prispevku najprej predstavimo osnovne pojme analize omre{\v z}ij, ter izpostavimo vidnej{\v s}e dose{\v z}ke in odkritja iz preteklih let. V nadaljevanju nato predstavimo izbrane primere uporabe ter podamo nekatere mo{\v z}nosti uporabe v javni upravi.},
language = {sl},
booktitle = {Zbornik {Konference} {Informatika} v {Javni} {Upravi}},
author = {{\v S}ubelj, Lovro and Blagus, Neli and Furlan, {\v S}tefan and Klemenc, Bojan and Kumer, Ale{\v s} and Lavbi{\v c}, Dejan and Zrnec, Alja{\v z} and {\v Z}itnik, Slavko and Bajec, Marko},
year = {2010},
pages = {10}
}

@article{LV11,
title = {Evaluation of classification quality and comparative analysis of clustering and self-organization},
volume = {6},
abstract = {Clustering is a way of classifying a multi-dimensional dataset by the similarities of its dimensions. The results from clustering must be analyzed to test the accuracy of the algorithm and its implementation. This analysis is sometimes done by a visual representation of the clustered dataset. However, it is impossible to visually represent a dataset with more than four dimensions. Statistical analysis makes this feasible. The analysis performed on the output calculates the centroid of each cluster and the cluster's relation to that centroid. We have investigated two modes of hierarchical clustering and spectral clustering. The standard deviation of each dimension from the centroid, the maximum Euclidean distance from the centroid, and the dimensions that elements of each cluster have in common are also computed. The performed experiments demonstrate which clustering algorithm presents most accurate results under certain circumstances through the use of a synthesis of visual representation and the statistical analysis proposed above.},
journal = {Procedia Computer Science},
author = {Larocque, Aaron and Valova, Iren},
year = {2011},
pages = {141--146}
}

