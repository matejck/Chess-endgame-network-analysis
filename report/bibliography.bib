@article{BCDS12,
title = {Jigsaw percolation: {Can} a random graph solve a puzzle?},
abstract = {We introduce a new kind of percolation on finite graphs called jigsaw percolation. This model attempts to capture networks of people who innovate by merging ideas and who collaboratively solve problems by piecing together solutions. Each node of a graph (regarded as a person in a social network) has a unique piece of a jigsaw puzzle. Acquainted people with compatible puzzle pieces merge their puzzle pieces. More generally, groups of people with merged puzzle pieces merge if the groups know one another and have a pair of compatible puzzle pieces. The social network solves the puzzle if it eventually merges all the puzzle pieces. For the case of an Erd{\textbackslash}H\{o\}s-R{\textbackslash}'\{e\}nyi social network with \$n\$ vertices and edge probability \$p\_n\$, we define the critical value \$p\_c(n)\$ for an arbitrary connected puzzle graph to be the value of \$p\_n\$ for which the probability of solving the puzzle equals 1/2. We prove that when the puzzle graph is the \$n\$-cycle, then \$p\_c(n) = {\textbackslash}Theta(1/{\textbackslash}log n)\$. For an arbitrary connected puzzle graph with bounded maximum degree (as \$n {\textbackslash}to {\textbackslash}infty\$), we prove that \$p\_c(n) = O(1/{\textbackslash}log n)\$ and \$p\_c(n) = {\textbackslash}omega(1/n{\textasciicircum}b)\$ for any \$b{\textgreater}0\$. These results provide a mechanism for the recent statistical claims that the more people interact, the more they innovate.},
journal = {e-print arXiv:12071927v1},
author = {Brummitt, Charles D. and Chatterjee, Shirshendu and Dey, Partha S. and Sivakoff, David},
year = {2012}
}

