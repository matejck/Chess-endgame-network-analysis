@article{CL11a,
title = {A quantitative methodology based on component analysis to identify key users in social networks},
abstract = {Social networks are gaining an increasing popularity on the Internet and are becoming a critical media for business and marketing, as testified by viral advertisement campaigns based on such networks. In this scenario, it is important to identify the key users that may play a critical role as sources or targets of content dissemination. Existing approaches basically rely only on users social connections; however, considering a single kind of information does not guarantee satisfactory results for the identification of the key users. On the other hand, considering every possible user attribute is clearly unfeasible due to the high number and heterogeneity of available user information. In this paper, we propose to select and combine a subset of user attributes with the goal to identify sources and targets in a social network. To this aim, we develop a quantitative methodology based on the Principal Component Analysis. We apply the proposed methodology to the YouTube and Flickr networks for identifying which users may be preferential sources and targets for content dissemination. Experiments demonstrate that our solution outperforms existing solutions and can determine the top fraction of the users that will be responsible for the upload of more than 95{\textbackslash}\% of the most viewed videos.},
journal = {Int. J. Soc. Netw. Min.},
author = {Canali, Claudia and Lancellotti, Riccardo},
year = {2011}
}

@inproceedings{Kle01,
title = {Small-world phenomena and the dynamics of information},
abstract = {Introduction The problem of searching for information in networks like the World Wide Web can be approached in a variety of ways, ranging from centralized indexing schemes to decentralized mechanisms that navigate the underlying network without knowledge of its global structure. The decentralized approach appears in a variety of settings: in the behavior of users browsing the Web by following hyperlinks; in the design of focused crawlers [4, 5, 8] and other agents that explore the Web's links to gather information; and in the search protocols underlying decentralized peer-to-peer systems such as Gnutella [10], Freenet [7], and recent research prototypes [21, 22, 23], through which users can share resources without a central server. In recent work, we have been investigating the problem of decentralized search in large information networks [14, 15]. Our initial motivation was an experiment that dealt directly with the search problem in a decidedly pre-Internet context: Stanley Milgram},
booktitle = {Proceedings of the {International} {Conference} in {Advances} in {Neural} {Information} {Processing} {Systems}},
author = {Kleinberg, Jon},
year = {2001}
}

