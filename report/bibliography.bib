@article{WGBLR10,
title = {Enhanced visual analysis for cluster tendency assessment and data partitioning},
volume = {22},
abstract = {Visual methods have been widely studied and used in data cluster analysis. Given a pairwise dissimilarity matrix \{{\textbackslash}schmi D\} of a set of n objects, visual methods such as the VAT algorithm generally represent \{{\textbackslash}schmi D\} as an n{\textbackslash}times n image \{{\textbackslash}rm I\}({\textbackslash}tilde\{\{{\textbackslash}schmi D\}\}) where the objects are reordered to reveal hidden cluster structure as dark blocks along the diagonal of the image. A major limitation of such methods is their inability to highlight cluster structure when \{{\textbackslash}schmi D\} contains highly complex clusters. This paper addresses this limitation by proposing a Spectral VAT algorithm, where \{{\textbackslash}schmi D\} is mapped to \{{\textbackslash}schmi D\}{\textasciicircum}\{{\textbackslash}prime \} in a graph embedding space and then reordered to \{\{{\textbackslash}tilde\{{\textbackslash}schmi D\}{\textasciicircum}\{{\textbackslash}prime \}\}\} using the VAT algorithm. A strategy for automatic determination of the number of clusters in \{{\textbackslash}rm I\}(\{{\textbackslash}tilde\{\{{\textbackslash}schmi D\}{\textasciicircum}\{{\textbackslash}prime \}\}\}) is then proposed, as well as a visual method for cluster formation from \{{\textbackslash}rm I\}(\{{\textbackslash}tilde\{\{{\textbackslash}schmi D\}{\textasciicircum}\{{\textbackslash}prime \}\}\}) based on the difference between diagonal blocks and off-diagonal blocks. A sampling-based extended scheme is also proposed to enable visual cluster analysis for large data sets. Extensive experimental results on several synthetic and real-world data sets validate our algorithms.},
number = {10},
journal = {IEEE T. Knowl. Data En.},
author = {Wang, Liang and Geng, Xin and Bezdek, James and Leckie, Christopher and Ramamohanarao, Kotagiri},
year = {2010},
pages = {1401--1414}
}

