title = {Emergence of scaling in idiotypic networks},
booktitle = {Proceedings of the {European} {Conference} on {Complex} {Systems}},
author = {Gleria, Iram and Lyra, Marcelo and Bertrand, Delvis and Claudino, Elder and Campos, Paulo},
year = {2012}
