title = {Characterizing english poetic style using complex networks},
volume = {23},
number = {2},
journal = {Int. J. Mod. Phy. C},
author = {Roxas-Villanueva, Ranzivelle Marianne and Nambatac, Maelori Krista and Tapang, Giovanni},
year = {2012},
pages = {1250009}
